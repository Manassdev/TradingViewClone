PORT=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/tradingview
# For MongoDB Atlas (replace with your actual Atlas cluster URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tradingview?retryWrites=true&w=majority
# Generate a unique random value of at least 32 characters. Never commit the real value.
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
NODE_ENV=development
PAPER_INITIAL_BALANCE=100000
PAPER_ORDER_CHECK_INTERVAL_MS=15000
ALERT_CHECK_INTERVAL_MS=30000
GNEWS_API_KEY=
TWELVE_DATA_API_KEY=
# Maintain the official Indian exchange holiday dates for each calendar year as ISO dates.
# Example: INDIA_MARKET_HOLIDAYS=2026-01-26,2026-03-03
INDIA_MARKET_HOLIDAYS=
# Optional comma-separated 6-letter Forex symbols; optionally give a display name after a colon.
# Example: USDINR:US Dollar / Indian Rupee,USDMXN:US Dollar / Mexican Peso
FOREX_EXTRA_PAIRS=
