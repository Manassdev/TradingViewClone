PORT=5000
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/tradingview
# For MongoDB Atlas (replace with your actual Atlas cluster URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tradingview?retryWrites=true&w=majority
# Generate a unique random value of at least 32 characters. Never commit the real value.
JWT_SECRET=
NODE_ENV=development
ALERT_CHECK_INTERVAL_MS=30000
